<Control xmlns="https://spacestation14.io" xmlns:ui="clr-namespace:Content.Client.Lobby.UI" xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls" VerticalExpand="True">
    <TextureRect Name="PersonalizationBackdrop" Stretch="KeepAspectCovered" MouseFilter="Ignore"/>
    <ui:OnboardingBackdropShade MouseFilter="Ignore"/>
    <PanelContainer Name="BackgroundPanel" Margin="24">
        <BoxContainer Orientation="Vertical" SeparationOverride="12">
            <BoxContainer Name="Header" MinHeight="58" SeparationOverride="12">
                <Control Name="HeaderBalance"/>
                <BoxContainer Name="HeaderLockup" HorizontalExpand="True" HorizontalAlignment="Center" VerticalAlignment="Center" SeparationOverride="12">
                <TextureRect Name="HeaderOrnament" SetSize="96 30" Stretch="KeepAspectCentered" CanShrink="True" Modulate="#FFFFFFC7" VerticalAlignment="Center" MouseFilter="Ignore" TexturePath="/Textures/_WH40K/Interface/header-laurel.svg.192dpi.png"/>
                <Label Name="Title" Text="{Loc 'wh40k-personalization-title'}" VerticalAlignment="Center" FontColorOverride="#F1E3C8"/>
                <ui:OnboardingMirroredTextureRect Name="HeaderRightOrnament" SetSize="96 30" Stretch="KeepAspectCentered" CanShrink="True" Modulate="#FFFFFFC7" VerticalAlignment="Center" MouseFilter="Ignore" TexturePath="/Textures/_WH40K/Interface/header-laurel.svg.192dpi.png"/>
                </BoxContainer>
                <BoxContainer Name="HeaderActions" VerticalAlignment="Center" SeparationOverride="12">
                <Button Name="HelpButton" Text="{Loc 'wh40k-personalization-help'}" ToolTip="{Loc 'wh40k-personalization-help-tooltip'}" VerticalAlignment="Center"/>
                <Button Name="CloseButton" Access="Public" Text="{Loc 'wh40k-personalization-back'}" VerticalAlignment="Center"/>
                </BoxContainer>
            </BoxContainer>
            <ui:OnboardingGradientLine StartColor="#B697547A" MiddleColor="#B697543B" EndColor="#B697547A" Thickness="1" SetHeight="1"/>
            <BoxContainer VerticalExpand="True">
                <ScrollContainer MinSize="325 0" Visible="False">
                    <BoxContainer Name="Characters" Orientation="Vertical"/>
                </ScrollContainer>
                <BoxContainer Name="CharEditor" HorizontalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
    <Popup Name="HelpPopup">
        <PanelContainer StyleClasses="Wh40kPersonalizationField">
            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                <Button Name="StatsButton" Text="{Loc 'character-setup-gui-character-setup-stats-button'}"/>
                <Button Name="RulesButton" Text="{Loc 'character-setup-gui-character-setup-rules-button'}"/>
                <Button Name="DecorationsButton" Text="{Loc 'w40k-decs-button'}"/>
                <cc:CommandButton Name="AdminRemarksButton" Command="adminremarks" Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"/>
            </BoxContainer>
        </PanelContainer>
    </Popup>
</Control>
