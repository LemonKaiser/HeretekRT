<?xml version="1.0" encoding="utf-8"?>
<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:stylesheets="clr-namespace:Content.Client.Stylesheets">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
        <Button Name="TraitButton" Access="Public" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                <BoxContainer SeparationOverride="8">
                    <Label Name="NameLabel" HorizontalExpand="True" ClipText="True" />
                    <Label Name="CostLabel" />
                </BoxContainer>
                <RichTextLabel Name="DescriptionLabel" HorizontalExpand="True" />
            </BoxContainer>
        </Button>
    </BoxContainer>
</Control>
