<tabs:GraphicsTab xmlns:heritage="clr-namespace:Content.Client._WH40K.UserInterface"
         xmlns="https://spacestation14.io"
          xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
          xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <!-- Display -->
                <Label Text="{Loc 'ui-options-display-label'}" StyleClasses="Wh40kSectionHeading"/>
                <heritage:Wh40kToggleSwitch Name="VSyncCheckBox" Text="{Loc 'ui-options-vsync'}" />
                <heritage:Wh40kToggleSwitch Name="FullscreenCheckBox" Text="{Loc 'ui-options-fullscreen'}" />
                <ui:OptionDropDown Name="DropDownMaxFps" Title="{Loc 'wh40k-options-max-fps'}" />

                <!-- Quality -->
                <Label Text="{Loc 'ui-options-quality-label'}" StyleClasses="Wh40kSectionHeading"/>
                <ui:OptionDropDown Name="DropDownLightingQuality" Title="{Loc 'ui-options-lighting-label'}" />
                <ui:OptionDropDown Name="DropDownParticleQuality" Title="{Loc 'ui-options-particles-label'}" />
                <heritage:Wh40kToggleSwitch Name="ViewportLowResCheckBox" Text="{Loc 'ui-options-vp-low-res'}" />
                <heritage:Wh40kToggleSwitch Name="ParallaxLowQualityCheckBox" Text="{Loc 'ui-options-parallax-low-quality'}" />
                <heritage:Wh40kToggleSwitch Name="AmbientOcclusionCheckBox" Text="{Loc 'ui-options-ambient-occlusion'}" />
                <!-- Far Horizons start -->
                <heritage:Wh40kToggleSwitch Name="RenderStarSystemCheckBox" Text="{Loc 'ui-options-render-star-system'}" />
                <!-- Far Horizons end -->

                <Label Text="{Loc 'wh40k-options-world-effects'}" StyleClasses="Wh40kSectionHeading"/>
                <heritage:Wh40kToggleSwitch Name="WorldGlowCheckBox" Text="{Loc 'wh40k-options-world-glow'}"
                          ToolTip="{Loc 'wh40k-options-world-glow-tooltip'}" />
                <heritage:Wh40kToggleSwitch Name="ContactShadowsCheckBox" Text="{Loc 'wh40k-options-contact-shadows'}"
                          ToolTip="{Loc 'wh40k-options-contact-shadows-tooltip'}" />
                <heritage:Wh40kToggleSwitch Name="PuddleReflectionsCheckBox" Text="{Loc 'wh40k-options-puddle-reflections'}"
                          ToolTip="{Loc 'wh40k-options-puddle-reflections-tooltip'}" />
                <heritage:Wh40kToggleSwitch Name="BloodTrailsCheckBox" Text="{Loc 'wh40k-options-blood-trails'}"
                          ToolTip="{Loc 'wh40k-options-blood-trails-tooltip'}" />
                <heritage:Wh40kToggleSwitch Name="ShockwaveCheckBox" Text="{Loc 'wh40k-options-shockwave'}" />
                <ui:OptionSlider Name="ShockwaveStrengthSlider" Title="{Loc 'wh40k-options-shockwave-strength'}" />
                <heritage:Wh40kToggleSwitch Name="HeatHazeCheckBox" Text="{Loc 'wh40k-options-heat-haze'}" />
                <ui:OptionSlider Name="HeatHazeStrengthSlider" Title="{Loc 'wh40k-options-heat-haze-strength'}" />
                <heritage:Wh40kToggleSwitch Name="WarmthOverlayCheckBox" Text="{Loc 'wh40k-options-warmth-overlay'}"
                          ToolTip="{Loc 'wh40k-options-warmth-overlay-tooltip'}" />
                <ui:OptionDropDown Name="DropDownWeatherQuality" Title="{Loc 'wh40k-options-weather-quality'}" />

                <!-- Interface -->
                <Label Text="{Loc 'ui-options-interface-label'}" StyleClasses="Wh40kSectionHeading"/>
                <ui:OptionDropDown Name="DropDownUIScale" Title="{Loc 'ui-options-scale-label'}" />
                <heritage:Wh40kToggleSwitch Name="ViewportStretchCheckBox" Text="{Loc 'ui-options-vp-stretch'}" />
                <ui:OptionSlider Name="ViewportScaleSlider" Title="{Loc ui-options-vp-scale}" />
                <ui:OptionSlider Name="ViewportWidthSlider" Title="{Loc ui-options-vp-width}" />
                <heritage:Wh40kToggleSwitch Name="IntegerScalingCheckBox"
                          Text="{Loc 'ui-options-vp-integer-scaling'}"
                          ToolTip="{Loc 'ui-options-vp-integer-scaling-tooltip'}" />
                <heritage:Wh40kToggleSwitch Name="ViewportVerticalFitCheckBox"
                          Text="{Loc 'ui-options-vp-vertical-fit'}"
                          ToolTip="{Loc 'ui-options-vp-vertical-fit-tooltip'}" />

                <!-- Misc -->
                <Label Text="{Loc 'ui-options-misc-label'}" StyleClasses="Wh40kSectionHeading"/>
                <heritage:Wh40kToggleSwitch Name="FpsCounterCheckBox" Text="{Loc 'ui-options-fps-counter'}" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</tabs:GraphicsTab>
