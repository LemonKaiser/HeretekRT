<pda:PdaProgramItem HorizontalExpand="True" MinHeight="56"
                    xmlns:pda="clr-namespace:Content.Client.PDA"
                    xmlns="https://spacestation14.io">
    <PanelContainer Name="Panel"/>
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="3 3 3 2">
        <PanelContainer Name="IconPlate" SetSize="38 32" HorizontalAlignment="Center">
            <AnimatedTextureRect Name="Icon" Access="Public" SetSize="24 24"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </PanelContainer>
        <Label Name="ProgramName" Access="Public" StyleClasses="PdaGadOsAppLabel" ClipText="True"
               HorizontalExpand="True" MinHeight="12" FontColorOverride="#D7E0D7"/>
    </BoxContainer>
    <Button Name="InstallButton" Access="Public" Visible="False" SetSize="14 14"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 2 2 0" />
</pda:PdaProgramItem>
