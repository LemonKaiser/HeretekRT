<pda:PdaSettingsButton xmlns="https://spacestation14.io"
                       xmlns:pda="clr-namespace:Content.Client.PDA"
                       HorizontalExpand="True"
                       MinHeight="52"
                       Margin="2 2 2 0">
    <PanelContainer Name="Panel"/>
    <PanelContainer Name="AccentRail" SetWidth="2" HorizontalAlignment="Left" />
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10 5 7 5">
        <Label Name="OptionName" FontColorOverride="#D7E0D7"/>
        <Label Name="OptionDescription" FontColorOverride="#93A096"/>
    </BoxContainer>
</pda:PdaSettingsButton>
