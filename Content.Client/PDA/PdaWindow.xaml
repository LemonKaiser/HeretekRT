<pda:PdaWindow  xmlns="https://spacestation14.io"
                xmlns:pda="clr-namespace:Content.Client.PDA"
                MouseFilter="Stop">
    <PanelContainer Name="Background" Access="Public" />
    <!-- The negative markin fixes a gap between the window edges and the decorative panel -->
    <PanelContainer Name="AccentH" Margin="-1 170 -2 170" Access="Public" />
    <PanelContainer Name="AccentV" Margin="220 -1 220 -1" Access="Public" />
    <PanelContainer Name="Border" />
    <TextureRect Name="DataslateFrame" Access="Public" HorizontalExpand="True" VerticalExpand="True"
                 Stretch="Scale" MouseFilter="Ignore"
                 TexturePath="/Textures/_WH40K/Interface/PDA/gados-dataslate-frame.svg.192dpi.png" />
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <!-- Keep only the close control on the physical top plate. -->
        <BoxContainer SetHeight="32" Margin="42 4 16 0" Orientation="Horizontal">
            <Control HorizontalExpand="True"/>
            <pda:PdaTerminalCloseButton Name="CloseButton"
                                        SetSize="20 20"
                                        VerticalAlignment="Bottom"
                                        Margin="0 0 34 0"/>
        </BoxContainer>
        <!-- The terminal starts beneath the upper facet and ends above the lower one. -->
        <Control Margin="28 10 28 43" RectClipContent="True" VerticalExpand="True"
                 HorizontalExpand="True">
            <PanelContainer Name="ContentBorder" />
            <pda:PdaTerminalCrtShaderContainer Margin="3 3" RectClipContent="True">
                <PanelContainer Name="ContentBackground" />
                <BoxContainer Access="Public" Name="ContentsContainer" Orientation="Vertical" HorizontalExpand="True"
                              VerticalExpand="True" StyleClasses="PdaContent"/>
            </pda:PdaTerminalCrtShaderContainer>
        </Control>
        <!-- The lower physical deck remains unobstructed; the address stays on the in-screen service rail. -->
        <Control SetHeight="34" />
    </BoxContainer>
</pda:PdaWindow>
