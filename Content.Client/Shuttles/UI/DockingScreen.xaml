<controls:BoxContainer Visible="False"
                       HorizontalExpand="True"
                       VerticalExpand="True"
                       xmlns:controls="https://spacestation14.io"
                       xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
                       xmlns:ui="clr-namespace:Content.Client.Shuttles.UI"
                       xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <ui:ShuttleDockControl Name="DockingControl"
                           MouseFilter="Stop"
                           VerticalExpand="True"
                           HorizontalExpand="True"
                           Margin="5 4 10 5"/>
    <controls:PanelContainer VerticalExpand="True" SetWidth="286" Margin="4">
        <controls:PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#79603D" BackgroundColor="#18140F"/>
        </controls:PanelContainer.PanelOverride>
        <controls:BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="8">
            <controls1:StripeBack MinHeight="32">
                <controls:Label Text="{controls:Loc 'shuttle-console-ftl-lock'}" HorizontalAlignment="Center"/>
            </controls1:StripeBack>
            <controls:BoxContainer Orientation="Horizontal">
                <controls:Button Name="FTLLockEnabledButton"
                                 Text="{controls:Loc 'shuttle-console-ftl-lock-enabled'}"
                                 ToggleMode="True"
                                 HorizontalExpand="True"
                                 StyleClasses="OpenRight"/>
                <controls:Button Name="FTLLockDisabledButton"
                                 Text="{controls:Loc 'shuttle-console-ftl-lock-disabled'}"
                                 ToggleMode="True"
                                 HorizontalExpand="True"
                                 StyleClasses="OpenLeft"/>
            </controls:BoxContainer>

            <controls1:StripeBack MinHeight="32">
                <controls:Label Text="{controls:Loc 'shuttle-console-auto-dock'}" HorizontalAlignment="Center"/>
            </controls1:StripeBack>
            <controls:BoxContainer Orientation="Horizontal">
                <controls:Button Name="AutoDockDisabledButton"
                                 Text="{controls:Loc 'shuttle-console-auto-dock-disabled'}"
                                 ToggleMode="True"
                                 HorizontalExpand="True"
                                 StyleClasses="OpenRight"/>
                <controls:Button Name="AutoDockEnabledButton"
                                 Text="{controls:Loc 'shuttle-console-auto-dock-enabled'}"
                                 ToggleMode="True"
                                 HorizontalExpand="True"
                                 StyleClasses="OpenLeft"/>
            </controls:BoxContainer>

            <controls1:StripeBack MinHeight="32">
                <controls:Label Text="{controls:Loc 'shuttle-console-docks-label'}" HorizontalAlignment="Center"/>
            </controls1:StripeBack>
            <controls:Button Name="UndockAllButton"
                             Text="{controls:Loc 'shuttle-console-undock-all'}"
                             Disabled="True"
                             StyleClasses="ButtonSquare"/>
            <controls:Label Name="NoDockPorts"
                            Text="{controls:Loc 'wh40k-shuttle-console-no-dock-ports'}"
                            StyleClasses="LabelSubText"
                            HorizontalAlignment="Center"
                            Margin="0 6"/>
            <controls:ScrollContainer Name="DockPortList" Visible="False" VerticalExpand="True" HScrollEnabled="False">
                <controls:BoxContainer Name="DockPorts" Orientation="Vertical" SeparationOverride="4"/>
            </controls:ScrollContainer>
        </controls:BoxContainer>
    </controls:PanelContainer>
</controls:BoxContainer>
