<Control xmlns="https://spacestation14.io" xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="5">
            <LineEdit Name="SearchEdit" HorizontalExpand="True" PlaceHolder="{Loc 'humanoid-profile-editor-voice-placeholder'}"/>
            <Label Name="ResultsLabel" MinWidth="100" HorizontalExpand="True" HorizontalAlignment="Right"/>
        </BoxContainer>

        <PanelContainer Name="CategoriesPanel" HorizontalExpand="True" VerticalExpand="False" SetHeight="54" Margin="0 5 0 12">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#100D0A" BorderColor="#56452D" BorderThickness="1" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="5">
                <Label Name="CategoriesTitle" Text="{Loc 'humanoid-profile-editor-voice-categories'}" StyleClasses="LabelHeading" HorizontalAlignment="Center" Margin="0 0 0 5"/>
                <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                    <GridContainer Name="CategoriesContainer" HorizontalExpand="True"/>
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>

        <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="5">
            <GridContainer Name="VoicesGrid" HorizontalExpand="True"/>
        </ScrollContainer>
    </BoxContainer>
</Control>
