        <Label Name="MessageLabel" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="8">
            <Button Name="CancelButton" />
            <Button Name="ConfirmButton" StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
