<BoxContainer xmlns="https://spacestation14.io"
              xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              xmlns:ui="clr-namespace:Content.Client._Mono.Sensors.UI"
              Orientation="Vertical"
              HorizontalExpand="True"
              VerticalExpand="True"
              Margin="6">

    <controls:StripeBack MinSize="36 36">
        <Label Text="{Loc 'gunnery-emcon-sensors'}" HorizontalAlignment="Left" StyleClasses="StatusFieldTitle"/>
    </controls:StripeBack>

    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
        <PanelContainer MinHeight="192" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#000000"/>
            </PanelContainer.PanelOverride>
            <ScrollContainer HScrollEnabled="False">
                <BoxContainer Name="HardwareBox" Orientation="Vertical" SeparationOverride="6" Margin="4"/>
            </ScrollContainer>
        </PanelContainer>

        <PanelContainer SetSize="160 160">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#000000"/>
            </PanelContainer.PanelOverride>
            <ui:SensorsArcDisplay Name="ArcDisplay"/>
        </PanelContainer>
    </BoxContainer>

    <controls:StripeBack MinSize="36 36" Margin="0 8 0 0">
        <Label Text="{Loc 'gunnery-emcon-contacts'}" HorizontalAlignment="Left" StyleClasses="StatusFieldTitle"/>
    </controls:StripeBack>
    <LineEdit Name="ContactSearch" PlaceHolder="{Loc 'gunnery-emcon-search-placeholder'}" Margin="2"/>

    <PanelContainer VerticalExpand="True">
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#000000"/>
        </PanelContainer.PanelOverride>
        <ScrollContainer>
            <BoxContainer Orientation="Vertical" Margin="4">
                <BoxContainer Name="ContactHeader" Orientation="Vertical"/>
                <BoxContainer Name="ContactsBox" Orientation="Vertical"/>
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>

    <controls:StripeBack MinSize="32 32" Margin="0 8 0 0">
        <Label Text="{Loc 'gunnery-emcon-datalink'}" HorizontalAlignment="Left" StyleClasses="StatusFieldTitle"/>
    </controls:StripeBack>
    <BoxContainer Orientation="Horizontal" Margin="2">
        <LineEdit Name="DatalinkEdit" HorizontalExpand="True" PlaceHolder="{Loc 'gunnery-emcon-datalink-placeholder'}"/>
        <Button Name="DatalinkApply" Text="{Loc 'gunnery-emcon-datalink-apply'}" MinWidth="64"/>
    </BoxContainer>
</BoxContainer>
