<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                HorizontalExpand="True">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat BorderThickness="3" BorderColor="#101010" BackgroundColor="#242424"/>
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  Margin="8"
                  SeparationOverride="8">
        <RichTextLabel Name="VesselName"
                       Access="Public"
                       HorizontalExpand="True"
                       VerticalAlignment="Top" />
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1a1b1c"/>
            </PanelContainer.PanelOverride>
            <RichTextLabel Name="VesselDescription"
                           Access="Public"
                           HorizontalExpand="True"
                           VerticalAlignment="Top"
                           Margin="6"
                           Modulate="#999999"/>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="8">
        <Label Name="Price"
            Access="Public"
            MinWidth="100"
            VerticalAlignment="Center" />
        <controls:ConfirmButton Name="Purchase"
            Access="Public"
            ToolTip=""
            Text="{Loc 'shipyard-console-purchase-available'}"
            ConfirmationText="{Loc 'shipyard-console-confirm-unassign'}"
            StyleClasses="ButtonSquare"
            HorizontalExpand="True"
            MinHeight="32"
            TextAlign="Center" />
        <Button Name="Guidebook"
            Access="Public"
            Text="{Loc 'shipyard-console-guidebook'}"
            StyleClasses="ButtonSquare"
            HorizontalExpand="True"
            MinHeight="32"
            TextAlign="Center" />
        <Button Name="Preview"
                Access="Public"
                Text="{Loc 'shipyard-console-preview'}"
                StyleClasses="ButtonSquare"
                HorizontalExpand="True"
                MinHeight="32"
                TextAlign="Center" />
    </BoxContainer>
    </BoxContainer>
</PanelContainer>
