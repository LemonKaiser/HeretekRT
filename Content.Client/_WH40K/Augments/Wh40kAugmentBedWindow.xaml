<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:aug="clr-namespace:Content.Client._WH40K.Augments"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="{Loc 'wh40k-augment-bed-title'}" MinSize="690 512" SetSize="820 585">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="8">
        <PanelContainer Name="HeaderPanel" Visible="False">
            <Label Name="PowerStatus"/>
        </PanelContainer>
        <BoxContainer HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8">
            <PanelContainer Name="Scanner" SetWidth="365">
                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <BoxContainer SeparationOverride="6">
                        <Label Text="{Loc 'wh40k-augments-body-map'}" HorizontalExpand="True"/>
                        <Button Name="AllZones" Text="{Loc 'wh40k-augment-bed-all'}"/>
                    </BoxContainer>
                    <aug:Wh40kAugmentBodyMap Name="BodyMap" StackLabels="True" HorizontalExpand="True" VerticalExpand="True"/>
                    <PanelContainer Name="FacingPanel" HorizontalAlignment="Right">
                        <BoxContainer SeparationOverride="4">
                            <Button Name="TurnLeft" Text="◀" MinWidth="32" ToolTip="{Loc 'wh40k-augments-turn-left'}"/>
                            <Label Name="FacingLabel" MinWidth="50" Align="Center"/>
                            <Button Name="TurnRight" Text="▶" MinWidth="32" ToolTip="{Loc 'wh40k-augments-turn-right'}"/>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer Name="InventoryPanel" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" SeparationOverride="8">
                    <Label Name="InventoryTitle" FontColorOverride="{x:Static aug:Wh40kAugmentStyle.Text}"/>
                    <ScrollContainer Name="ItemScroll" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True">
                            <BoxContainer Name="ZoneContents" Orientation="Vertical" SeparationOverride="5" HorizontalExpand="True"/>
                            <BoxContainer Name="Items" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"/>
                            <RichTextLabel Name="Empty" HorizontalExpand="True" Visible="False"/>
                        </BoxContainer>
                    </ScrollContainer>
                    <BoxContainer Name="SelectionPanel" Orientation="Vertical" SeparationOverride="6" Visible="False">
                        <RichTextLabel Name="Details" HorizontalExpand="True"/>
                        <Button Name="Confirm" Text="{Loc 'wh40k-augment-bed-confirm'}" Disabled="True" MinHeight="32"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
