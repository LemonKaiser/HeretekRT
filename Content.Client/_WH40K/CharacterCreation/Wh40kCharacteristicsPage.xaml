<characterCreation:Wh40kCharacteristicsPage
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:characterCreation="clr-namespace:Content.Client._WH40K.CharacterCreation"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    HorizontalExpand="True" VerticalExpand="True">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="10">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Center"
                          VerticalAlignment="Center" SeparationOverride="8">
                <PanelContainer SetWidth="110" SetHeight="1" VerticalAlignment="Center">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#B69754B8" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                <TextureRect SetSize="36 21" Stretch="KeepAspectCentered" CanShrink="True" MouseFilter="Ignore"
                             Modulate="#B69754A8"
                             TexturePath="/Textures/_WH40K/CharacterCreation/Ornaments/heading-laurel.svg.192dpi.png" />
                <Label Name="CharacteristicsTitle" Access="Public" Text="{Loc 'heretek-onboarding-characteristics'}"
                       FontColorOverride="#E5C879" HorizontalAlignment="Center"
                       StyleClasses="Wh40kOnboardingSectionTitle" />
                <lobbyUi:OnboardingMirroredTextureRect SetSize="36 21" Stretch="KeepAspectCentered" CanShrink="True"
                                                        MouseFilter="Ignore" Modulate="#B69754A8"
                                                        TexturePath="/Textures/_WH40K/CharacterCreation/Ornaments/heading-laurel.svg.192dpi.png" />
                <PanelContainer SetWidth="110" SetHeight="1" VerticalAlignment="Center">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#B69754B8" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
            </BoxContainer>
            <Label Text="{Loc 'heretek-onboarding-characteristics-distribution-title'}" FontColorOverride="#B69754"
                   HorizontalAlignment="Center" StyleClasses="Wh40kOnboardingTechnicalText" />

            <PanelContainer HorizontalExpand="True" Margin="0 5 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#080907A8" BorderColor="#B697547A" BorderThickness="1"
                                           ContentMarginLeftOverride="14" ContentMarginRightOverride="14"
                                           ContentMarginTopOverride="11" ContentMarginBottomOverride="11" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="18">
                    <RichTextLabel Text="{Loc 'heretek-onboarding-characteristics-controls-hint'}" HorizontalExpand="True"
                                   StyleClasses="Wh40kOnboardingBodyCompact" />
                    <Label Name="PointBudget" Access="Public" SetWidth="92" Align="Right" FontColorOverride="#E5C879"
                           StyleClasses="Wh40kOnboardingTechnicalLarge" />
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" Margin="0 5 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#251D0DB5" BorderColor="#B697547A" BorderThickness="1"
                                           ContentMarginLeftOverride="0" ContentMarginRightOverride="18"
                                           ContentMarginTopOverride="17" ContentMarginBottomOverride="17" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="14">
                    <PanelContainer SetWidth="2" VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#E5C879" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="14">
                            <Label Name="SelectedCharacteristicIndex" Access="Public" SetWidth="42" Align="Center"
                                   FontColorOverride="#B69754" VerticalAlignment="Center"
                                   StyleClasses="Wh40kOnboardingTechnicalText" />
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="3">
                                <Label Text="{Loc 'heretek-onboarding-characteristics-information-title'}" FontColorOverride="#B69754"
                                       StyleClasses="Wh40kOnboardingTechnicalText" />
                                <Label Name="CharacteristicTitle" Access="Public" ClipText="True" FontColorOverride="#DFD7C3"
                                       StyleClasses="Wh40kOnboardingBodyStrong" />
                                <Label Name="CharacteristicModifiers" Access="Public" FontColorOverride="#E5C879"
                                       StyleClasses="Wh40kOnboardingTechnicalText" />
                            </BoxContainer>
                            <BoxContainer Orientation="Horizontal" SetWidth="126" VerticalAlignment="Center" SeparationOverride="0">
                                <Button Name="DecreaseButton" Access="Public" Text="−" SetWidth="36" MinHeight="38" />
                                <PanelContainer SetWidth="54" MinHeight="38">
                                    <PanelContainer.PanelOverride>
                                        <graphics:StyleBoxFlat BackgroundColor="#100F08CC" BorderColor="#B6975452" BorderThickness="1" />
                                    </PanelContainer.PanelOverride>
                                    <Label Name="SelectedCharacteristicPoints" Access="Public" Align="Center" FontColorOverride="#E5C879"
                                           StyleClasses="Wh40kOnboardingTechnicalValue" />
                                </PanelContainer>
                                <Button Name="IncreaseButton" Access="Public" Text="+" SetWidth="36" MinHeight="38" />
                            </BoxContainer>
                        </BoxContainer>
                        <RichTextLabel Name="CharacteristicDescription" Access="Public" HorizontalExpand="True" Margin="56 0 0 0"
                                       StyleClasses="Wh40kOnboardingBodySmall" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" Margin="0 5 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#08090776" BorderColor="#B6975447" BorderThickness="1"
                                           ContentMarginLeftOverride="16" ContentMarginRightOverride="16"
                                           ContentMarginTopOverride="14" ContentMarginBottomOverride="14" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="7">
                    <Label Name="EffectHeading" Access="Public" FontColorOverride="#B69754" StyleClasses="Wh40kOnboardingTechnicalText" />
                    <RichTextLabel Name="CharacteristicEffect" Access="Public" HorizontalExpand="True" StyleClasses="Wh40kOnboardingBodyCompact" />
                </BoxContainer>
            </PanelContainer>
            <Control VerticalExpand="True" />
        </BoxContainer>
    </ScrollContainer>
</characterCreation:Wh40kCharacteristicsPage>
