<characterCreation:Wh40kTraitsPage
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:characterCreation="clr-namespace:Content.Client._WH40K.CharacterCreation"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    HorizontalExpand="True" VerticalExpand="True">
    <!-- Keep all copy inside the onboarding content frame.  Rich text receives a finite width only when
         horizontal scrolling is disabled, so it can wrap instead of expanding the whole page. -->
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="0">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Center"
                          VerticalAlignment="Center" SeparationOverride="8">
                <PanelContainer SetWidth="110" SetHeight="1" VerticalAlignment="Center">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#B69754B8" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                <TextureRect SetSize="36 21" Stretch="KeepAspectCentered" CanShrink="True" MouseFilter="Ignore"
                             Modulate="#B69754A8"
                             TexturePath="/Textures/_WH40K/CharacterCreation/Ornaments/heading-laurel.svg.192dpi.png" />
                <Label Name="TraitTitle" Access="Public" FontColorOverride="#E5C879" HorizontalAlignment="Center"
                       StyleClasses="Wh40kOnboardingSectionTitle" />
                <lobbyUi:OnboardingMirroredTextureRect SetSize="36 21" Stretch="KeepAspectCentered" CanShrink="True"
                                                        MouseFilter="Ignore" Modulate="#B69754A8"
                                                        TexturePath="/Textures/_WH40K/CharacterCreation/Ornaments/heading-laurel.svg.192dpi.png" />
                <PanelContainer SetWidth="110" SetHeight="1" VerticalAlignment="Center">
                    <PanelContainer.PanelOverride>
                        <graphics:StyleBoxFlat BackgroundColor="#B69754B8" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
            </BoxContainer>
            <Label Name="TraitKind" FontColorOverride="#B69754" HorizontalAlignment="Center"
                   Margin="0 16 0 4" StyleClasses="Wh40kOnboardingTechnicalText" />
            <lobbyUi:OnboardingGradientLine StartColor="#B69754" MiddleColor="#B6975438"
                                             EndColor="#00000000" Thickness="1" SetHeight="1" />

            <PanelContainer HorizontalExpand="True" Margin="0 10 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#0D0F0C94" BorderColor="#B6975447" BorderThickness="1"
                                           ContentMarginLeftOverride="18" ContentMarginRightOverride="18"
                                           ContentMarginTopOverride="14" ContentMarginBottomOverride="14" />
                </PanelContainer.PanelOverride>
                <RichTextLabel Name="TraitDescription" HorizontalExpand="True" StyleClasses="Wh40kOnboardingBodyText" />
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" Margin="0 12 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#0A0B0980" BorderColor="#B6975447" BorderThickness="1"
                                           ContentMarginLeftOverride="18" ContentMarginRightOverride="18"
                                           ContentMarginTopOverride="0" ContentMarginBottomOverride="0" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="18" Margin="0 16 0 14">
                        <Label Text="{Loc 'heretek-onboarding-traits-effect-title'}" SetWidth="154"
                               FontColorOverride="#B69754" VerticalAlignment="Top"
                               StyleClasses="Wh40kOnboardingTechnicalText" />
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8">
                            <RichTextLabel Name="TraitEffect" HorizontalExpand="True" StyleClasses="Wh40kOnboardingBodyText" />
                            <RichTextLabel Name="TraitAvailability" HorizontalExpand="True" StyleClasses="Wh40kOnboardingBodyText" />
                            <Button Name="TraitActionButton" Text="{Loc 'heretek-onboarding-traits-select'}"
                                    ClipText="True" SetWidth="180" HorizontalAlignment="Left" />
                        </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" Margin="0 12 0 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#0A0B0975" BorderColor="#B6975447" BorderThickness="1"
                                           ContentMarginLeftOverride="14" ContentMarginRightOverride="14"
                                           ContentMarginTopOverride="10" ContentMarginBottomOverride="10" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <RichTextLabel Name="TraitsBudget" HorizontalExpand="True" StyleClasses="Wh40kOnboardingBodyCompact" />
                </BoxContainer>
            </PanelContainer>

            <Control VerticalExpand="True" />

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 16 0 0" SeparationOverride="8">
                <controls:HLine Color="#B6975470" Thickness="1" />
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="5">
                    <Label Text="{Loc 'heretek-onboarding-traits-selected-title'}"
                           FontColorOverride="#B69754"
                           StyleClasses="Wh40kOnboardingTechnicalText" />
                    <RichTextLabel Name="SelectedTraits" HorizontalExpand="True" StyleClasses="Wh40kOnboardingBodyText" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </ScrollContainer>
</characterCreation:Wh40kTraitsPage>
