<Control xmlns="https://spacestation14.io" xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client" xmlns:creation="clr-namespace:Content.Client._WH40K.CharacterCreation" HorizontalExpand="True" VerticalExpand="True">
    <ScrollContainer HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" SeparationOverride="12">
            <Label Text="{Loc 'wh40k-description-appearance-label'}" StyleClasses="Wh40kOnboardingSectionTitle" FontColorOverride="#E1C17E"/>
            <Button Name="PreviewButton" Text="{Loc 'flavor-tab-preview'}" ToggleMode="True" HorizontalAlignment="Left"/>
            <BoxContainer Name="DescriptionEditor" Orientation="Vertical" SeparationOverride="14">
                <BoxContainer Name="DescriptionFields" SeparationOverride="16">
                    <BoxContainer Name="AppearanceEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                        <BoxContainer>
                            <Label Text="{Loc 'wh40k-description-appearance-label'}" HorizontalExpand="True"/>
                            <Label Name="AppearanceCounter"/>
                        </BoxContainer>
                        <PanelContainer StyleClasses="Wh40kPersonalizationField">
                            <TextEdit Name="AppearanceInput" MinHeight="160" HorizontalExpand="True" Margin="10"/>
                        </PanelContainer>
                    </BoxContainer>
                    <BoxContainer Name="CharacterEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                        <BoxContainer>
                            <Label Text="{Loc 'wh40k-description-traits-label'}" HorizontalExpand="True"/>
                            <Label Name="CharacterCounter"/>
                        </BoxContainer>
                        <PanelContainer StyleClasses="Wh40kPersonalizationField">
                            <TextEdit Name="CharacterInput" MinHeight="160" HorizontalExpand="True" Margin="10"/>
                        </PanelContainer>
                    </BoxContainer>
                </BoxContainer>
                <BoxContainer Name="OocGroup" Orientation="Vertical" SeparationOverride="8">
                    <Button Name="OocToggle" Text="{Loc 'wh40k-personalization-ooc'}" ToggleMode="True"/>
                    <BoxContainer Name="OocSection" Visible="False" Orientation="Vertical" SeparationOverride="10">
                        <BoxContainer Name="OocEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer>
                                <Label Text="{Loc 'wh40k-description-ooc-label'}" HorizontalExpand="True"/>
                                <Label Name="OocCounter"/>
                            </BoxContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <TextEdit Name="OocInput" MinHeight="140" HorizontalExpand="True" Margin="10"/>
                            </PanelContainer>
                        </BoxContainer>
                        <CheckBox Name="ShareOocCheck" Text="{Loc 'wh40k-description-share-ooc'}"/>
                        <BoxContainer Name="TagsEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer>
                                <Label Text="{Loc 'wh40k-description-tags-label'}" HorizontalExpand="True"/>
                                <Label Name="TagsCounter"/>
                            </BoxContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <TextEdit Name="TagsInput" MinHeight="64" HorizontalExpand="True" Margin="10"/>
                            </PanelContainer>
                        </BoxContainer>
                        <BoxContainer Name="LinksEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer>
                                <Label Text="{Loc 'wh40k-description-links-label'}" HorizontalExpand="True"/>
                                <Label Name="LinksCounter"/>
                            </BoxContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <TextEdit Name="LinksInput" MinHeight="80" HorizontalExpand="True" Margin="10"/>
                            </PanelContainer>
                        </BoxContainer>
                        <CheckBox Name="ShareLinksCheck" Text="{Loc 'wh40k-description-share-links'}"/>
                    </BoxContainer>
                </BoxContainer>
                <BoxContainer Name="PreferencesGroup" Orientation="Vertical" SeparationOverride="8">
                    <Button Name="PreferencesToggle" Text="{Loc 'flavor-tab-gyr'}" ToggleMode="True"/>
                    <BoxContainer Name="PreferencesEditor" Visible="False" Orientation="Vertical" SeparationOverride="10">
                        <BoxContainer Name="GreenEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer>
                                <Label Text="{Loc 'wh40k-description-preferences-green-label'}" HorizontalExpand="True"/>
                                <Label Name="GreenCounter"/>
                            </BoxContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <TextEdit Name="GreenInput" MinHeight="100" HorizontalExpand="True" Margin="10"/>
                            </PanelContainer>
                        </BoxContainer>
                        <BoxContainer Name="YellowEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer>
                                <Label Text="{Loc 'wh40k-description-preferences-yellow-label'}" HorizontalExpand="True"/>
                                <Label Name="YellowCounter"/>
                            </BoxContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <TextEdit Name="YellowInput" MinHeight="100" HorizontalExpand="True" Margin="10"/>
                            </PanelContainer>
                        </BoxContainer>
                        <BoxContainer Name="RedEditor" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="6">
                            <BoxContainer>
                                <Label Text="{Loc 'wh40k-description-preferences-red-label'}" HorizontalExpand="True"/>
                                <Label Name="RedCounter"/>
                            </BoxContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <TextEdit Name="RedInput" MinHeight="100" HorizontalExpand="True" Margin="10"/>
                            </PanelContainer>
                        </BoxContainer>
                        <CheckBox Name="SharePreferencesCheck" Text="{Loc 'wh40k-description-share-preferences'}"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
            <PanelContainer Name="DescriptionPreview" Visible="False" StyleClasses="Wh40kPersonalizationField">
                <BoxContainer Name="DescriptionPreviewColumns" SeparationOverride="16" Margin="12" Orientation="Vertical">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" Name="DescriptionPreviewText">
                        <TabContainer Name="PreviewTabs" HorizontalExpand="True" VerticalExpand="True" SetHeight="220">
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                    <RichTextLabel Name="PreviewAppearance" HorizontalExpand="True" Margin="10"/>
                                </ScrollContainer>
                            </PanelContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                    <RichTextLabel Name="PreviewTraits" HorizontalExpand="True" Margin="10"/>
                                </ScrollContainer>
                            </PanelContainer>
                            <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="10">
                                        <Label Text="{Loc 'wh40k-description-preferences-green-label'}" FontColorOverride="#64D886"/>
                                        <RichTextLabel Name="PreviewGreen" HorizontalExpand="True"/>
                                        <Label Text="{Loc 'wh40k-description-preferences-yellow-label'}" FontColorOverride="#F2C94C"/>
                                        <RichTextLabel Name="PreviewYellow" HorizontalExpand="True"/>
                                        <Label Text="{Loc 'wh40k-description-preferences-red-label'}" FontColorOverride="#D45B5B"/>
                                        <RichTextLabel Name="PreviewRed" HorizontalExpand="True"/>
                                    </BoxContainer>
                                </ScrollContainer>
                            </PanelContainer>
                        </TabContainer>
                        <GridContainer Columns="2" HorizontalExpand="True">
                            <BoxContainer Name="PreviewOocSection" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" Margin="0 0 8 0">
                                <Label Text="{Loc 'wh40k-description-ooc-label'}"/>
                                <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                    <ScrollContainer HScrollEnabled="False" MinHeight="96" MaxHeight="112">
                                        <RichTextLabel Name="PreviewOoc" HorizontalExpand="True" Margin="8"/>
                                    </ScrollContainer>
                                </PanelContainer>
                            </BoxContainer>
                            <BoxContainer Name="PreviewLinksSection" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                <Label Text="{Loc 'wh40k-description-links-label'}"/>
                                <PanelContainer StyleClasses="Wh40kPersonalizationField">
                                    <ScrollContainer HScrollEnabled="False" MinHeight="96" MaxHeight="112">
                                        <BoxContainer Name="PreviewLinks" Orientation="Vertical" Margin="8"/>
                                    </ScrollContainer>
                                </PanelContainer>
                            </BoxContainer>
                        </GridContainer>
                        <Label Name="PreviewTags" HorizontalExpand="True" ClipText="True"/>
                    </BoxContainer>
                    <PanelContainer Name="ProfileFooterPanel" HorizontalAlignment="Center" VerticalAlignment="Top" StyleClasses="Wh40kPersonalizationCard">
                        <BoxContainer Orientation="Vertical" SeparationOverride="12">
                            <Label Name="PreviewName" Align="Center" HorizontalExpand="True" ClipText="True" StyleClasses="Wh40kOnboardingSectionTitle"/>
                            <RichTextLabel Name="PreviewSummary" HorizontalExpand="True"/>
                            <PanelContainer Name="DescriptionSpriteStage" SetHeight="340" HorizontalExpand="True" StyleClasses="Wh40kPersonalizationCard">
                                <TextureRect TexturePath="/Textures/_WH40K/CharacterCreation/Ornaments/personalization-stage.svg.192dpi.png" Stretch="KeepAspectCentered" CanShrink="True" MouseFilter="Ignore"/>
                                <SpriteView Name="PreviewSprite" Stretch="Fill" Scale="1 1" Margin="14"/>
                                <PanelContainer Name="PreviewPortraitFrame" Visible="False" MouseFilter="Ignore">
                                    <TextureRect Name="PreviewPortrait" Stretch="KeepAspectCentered" CanShrink="True" MouseFilter="Ignore"/>
                                </PanelContainer>
                                <creation:Wh40kPortraitButton Name="PreviewPortraitButton" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"/>
                            </PanelContainer>
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </ScrollContainer>
</Control>
