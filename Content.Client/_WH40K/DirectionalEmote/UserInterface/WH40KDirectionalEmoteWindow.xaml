<ui:FancyWindow xmlns="https://spacestation14.io"
                xmlns:ui="clr-namespace:Content.Client.UserInterface.Controls"
                Title="Directional Emote"
                MinSize="440 210"
                SetSize="440 210">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="6">
        <TextEdit Name="MessageInput"
                  MinHeight="96"
                  MaxHeight="96"
                  HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal">
            <CheckBox Name="HideNameCheckBox"
                      Text="{Loc wh40k-directional-emote-hide-name}"
                      VerticalAlignment="Center"
                      Visible="False" />
            <Control HorizontalExpand="True" />
            <Button Name="LastEmoteButton"
                    Text="{Loc wh40k-directional-emote-last}"
                    MinWidth="128"
                    Margin="0 0 4 0"
                    StyleClasses="ButtonSquare" />
            <Button Name="AcceptButton"
                    Text="{Loc wh40k-directional-emote-button}"
                    MinWidth="100"
                    StyleClasses="ButtonColorGreen" />
        </BoxContainer>
    </BoxContainer>
</ui:FancyWindow>
