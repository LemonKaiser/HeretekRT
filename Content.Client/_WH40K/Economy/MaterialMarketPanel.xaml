<BoxContainer xmlns="https://spacestation14.io" Orientation="Horizontal" SeparationOverride="0">
    <PanelContainer Name="SaleBackground">
        <BoxContainer Orientation="Vertical" MinWidth="230" MaxWidth="230" Margin="16" SeparationOverride="8">
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True" MinHeight="230">
                <BoxContainer Orientation="Vertical" SeparationOverride="8">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'wh40k-market-sale-title'}" StyleClasses="LabelHeading" HorizontalExpand="True" />
                        <Label Text="{Loc 'wh40k-market-live'}" StyleClasses="LabelSubText" FontColorOverride="#9ed1aa" />
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" Margin="0 10 0 12" SeparationOverride="4">
                        <Label Text="{Loc 'wh40k-market-net'}" StyleClasses="LabelSubText" />
                        <Label Name="NetLabel" StyleClasses="LabelHeadingBigger" FontColorOverride="#cce2cb" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'wh40k-market-cargo-title'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                        <Label Name="GoodsLabel" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'wh40k-market-terminal-title'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                        <Label Name="TerminalLabel" />
                    </BoxContainer>
                    <Collapsible Name="Breakdown" BodyVisible="False">
                        <CollapsibleHeading Title="{Loc 'wh40k-market-breakdown'}" />
                        <CollapsibleBody Name="BreakdownBody" Visible="False">
                            <BoxContainer Orientation="Vertical" Margin="0 6" SeparationOverride="4">
                                <BoxContainer Orientation="Horizontal">
                                    <Label Text="{Loc 'wh40k-market-gross'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                                    <Label Name="GrossLabel" />
                                </BoxContainer>
                                <BoxContainer Orientation="Horizontal">
                                    <Label Name="CoefficientTitle" StyleClasses="LabelSubText" HorizontalExpand="True" />
                                    <Label Name="CoefficientLabel" />
                                </BoxContainer>
                                <BoxContainer Orientation="Horizontal">
                                    <Label Text="{Loc 'wh40k-market-fees'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                                    <Label Name="FeesLabel" />
                                </BoxContainer>
                                <RichTextLabel Name="SpecialLabel" Visible="False" StyleClasses="LabelSubText" />
                            </BoxContainer>
                        </CollapsibleBody>
                    </Collapsible>
                    <RichTextLabel Name="ReceiptLabel" Visible="False" />
                </BoxContainer>
            </ScrollContainer>
            <Button Name="SellButton" Text="{Loc 'wh40k-market-sell'}" HorizontalExpand="True" MinHeight="36" Disabled="True" />
        </BoxContainer>
    </PanelContainer>
    <PanelContainer Name="MarketBackground" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical" Margin="14 16" SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                <Label Text="{Loc 'wh40k-market-board-title'}" StyleClasses="LabelHeading" HorizontalExpand="True" />
                <Label Name="CycleLabel" StyleClasses="LabelSubText" FontColorOverride="#a9b6c3" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" SeparationOverride="12" Margin="0 6 12 0">
                <Label Text="{Loc 'wh40k-market-column-material'}" MinWidth="128" HorizontalExpand="True" StyleClasses="LabelSubText" />
                <Label Text="{Loc 'wh40k-market-column-price'}" MinWidth="84" MaxWidth="84" Align="Right" StyleClasses="LabelSubText" />
                <Label Text="{Loc 'wh40k-market-column-demand'}" MinWidth="78" MaxWidth="78" Align="Right" StyleClasses="LabelSubText" />
            </BoxContainer>
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True" MinHeight="180" ReserveScrollbarSpace="True">
                <BoxContainer Name="Entries" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0" />
            </ScrollContainer>
            <Label Name="QuietLabel" Text="{Loc 'wh40k-market-quiet'}" Visible="False" StyleClasses="LabelSubText" />
            <CheckBox Name="ShowAllCheckBox" Text="{Loc 'wh40k-market-show-all'}" />
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
