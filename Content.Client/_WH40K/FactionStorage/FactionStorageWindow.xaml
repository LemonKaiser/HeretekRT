<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'wh40k-faction-storage-title'}" MinSize="620 480" SetSize="720 620">
    <BoxContainer Orientation="Vertical" Margin="12">
        <Label Name="FactionLabel" StyleClasses="LabelHeading" />
        <RichTextLabel Name="RulesLabel" Margin="0 8" />
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
            <Label Name="CapacityLabel" HorizontalExpand="True" />
            <Button Name="RefreshButton" Text="{Loc 'wh40k-faction-storage-refresh'}" />
        </BoxContainer>
        <Label Name="BusyLabel" Text="{Loc 'wh40k-faction-storage-busy'}" Margin="0 0 0 6" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="Slots" Orientation="Vertical" HorizontalExpand="True" Margin="0 0 6 0" />
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
