<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      x:Class="Content.Client._WH40K.Factions.Capture.FactionCaptureWindow"
                      Title="{Loc 'wh40k-capture-terminal-title'}"
                      MinSize="440 360" SetSize="520 480">
    <BoxContainer Orientation="Vertical" Margin="12" SeparationOverride="9">
        <PanelContainer Name="SchedulePanel">
            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                <Label Name="WindowStatus" StyleClasses="LabelHeading" />
                <Label Name="Schedule" />
            </BoxContainer>
        </PanelContainer>
        <ScrollContainer Name="SitesScroll" VerticalExpand="True" HScrollEnabled="False" ReserveScrollbarSpace="True">
            <BoxContainer Name="Sites" Orientation="Vertical" SeparationOverride="8" HorizontalExpand="True" />
        </ScrollContainer>
        <Label Name="Empty" Text="{Loc 'wh40k-capture-no-points'}" Visible="False" />
    </BoxContainer>
</controls:FancyWindow>
