<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc 'wh40k-merchant-title'}"
    MinSize="760 580"
    SetSize="800 640">
    <BoxContainer Orientation="Vertical" Margin="14 12 14 12">
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 16 0">
                <Label Name="MerchantTitle" ClipText="True" StyleClasses="LabelHeading" FontColorOverride="#e4bd70" />
                <Label Name="MerchantSubtitle" StyleClasses="LabelSubText" Text="{Loc 'wh40k-merchant-subtitle'}" FontColorOverride="#8f9aa5" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalAlignment="Right" MinWidth="200">
                <Label Name="RefreshLabel" HorizontalAlignment="Right" StyleClasses="LabelSubText" FontColorOverride="#e4bd70" />
                <Label Name="CycleLabel" HorizontalAlignment="Right" StyleClasses="LabelSubText" FontColorOverride="#8f9aa5" />
            </BoxContainer>
        </BoxContainer>
        <PanelContainer StyleClasses="Inset" Margin="0 0 0 8">
            <RichTextLabel Name="GreetingLabel" Margin="10 8" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
            <Label Name="BalanceLabel" HorizontalExpand="True" FontColorOverride="#9ed1aa" />
            <Button Name="RefreshButton" Text="{Loc 'wh40k-merchant-refresh-button'}" />
        </BoxContainer>
        <ScrollContainer Name="OffersScroll" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="OffersContainer" Orientation="Vertical" HorizontalExpand="True" Margin="0 0 6 0" />
        </ScrollContainer>
        <Label Name="FooterLabel" Margin="0 8 0 0" StyleClasses="LabelSubText" FontColorOverride="#7d8791" />
        <BoxContainer Name="AppraisalRow" Orientation="Horizontal" Margin="0 8 0 0" Visible="False">
            <Button Name="AppraiseButton" Text="{Loc 'wh40k-service-appraise'}" />
            <Label Name="AppraisalLabel" HorizontalExpand="True" Margin="8 0" />
            <Button Name="SellButton" Text="{Loc 'wh40k-service-sell'}" Disabled="True" />
        </BoxContainer>
        <Label Name="ResultLabel" Margin="0 6 0 0" />
    </BoxContainer>
</DefaultWindow>
