<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:progression="clr-namespace:Content.Client._WH40K.Progression"
               Title="{Loc 'wh40k-class-ui-window-title'}"
               MinSize="1080 680"
               SetSize="1600 900">
    <PanelContainer Name="WindowFrame" HorizontalExpand="True" VerticalExpand="True" Margin="4">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="10"
                      SeparationOverride="8">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="10">
                <BoxContainer MinWidth="280" HorizontalExpand="True">
                    <TextureRect Name="ClassSigil" SetSize="30 30" Stretch="KeepAspectCentered" CanShrink="True"
                                 MouseFilter="Ignore" Modulate="#D9AF67"/>
                </BoxContainer>
                <LineEdit Name="SearchBox" SetWidth="320"
                          PlaceHolder="{Loc 'wh40k-class-ui-search-placeholder'}"/>
                <BoxContainer MinWidth="280" HorizontalExpand="True">
                    <Label Name="PointsHeader" MinWidth="280" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontColorOverride="#F2D44F"/>
                </BoxContainer>
            </BoxContainer>

            <RichTextLabel Name="StatusLabel" Visible="False" HorizontalExpand="True"/>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True"
                          SeparationOverride="8">
                <PanelContainer Name="GraphPanel" HorizontalExpand="True" VerticalExpand="True" MinWidth="650">
                    <progression:Wh40kClassTreeGraphControl Name="Graph" HorizontalExpand="True"
                                                            VerticalExpand="True" MinSize="650 470"/>
                </PanelContainer>

                <PanelContainer Name="DetailsPanel" SetWidth="365" VerticalExpand="True">
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="11"
                                      SeparationOverride="8">
                            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="9">
                                <TextureRect Name="SkillIcon" SetSize="52 52" Stretch="KeepAspectCentered"
                                             CanShrink="True" Modulate="#D7B45C"/>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="SkillTitle" FontColorOverride="#E8D39A" ClipText="True"/>
                                    <Label Name="SkillMeta" FontColorOverride="#8F8C82" ClipText="True"/>
                                </BoxContainer>
                            </BoxContainer>
                            <Label Text="{Loc 'wh40k-class-ui-information'}" FontColorOverride="#D7B45C"/>
                            <RichTextLabel Name="SkillDescription" HorizontalExpand="True"/>
                            <Label Text="{Loc 'wh40k-class-ui-requirements'}" FontColorOverride="#D7B45C"/>
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="3">
                                <Label Name="RequirementCostLabel" FontColorOverride="#D7D2C3"/>
                                <Label Name="RequirementLevelLabel" FontColorOverride="#D7D2C3"/>
                                <Label Name="RequirementPrerequisiteLabel" FontColorOverride="#D7D2C3"/>
                                <Label Name="RequirementEquipmentLabel" FontColorOverride="#D7D2C3"/>
                            </BoxContainer>
                            <Label Text="{Loc 'wh40k-class-ui-effects-header'}" FontColorOverride="#D7B45C"/>
                            <RichTextLabel Name="SkillEffects" HorizontalExpand="True"/>
                            <Button Name="PurchaseButton" HorizontalExpand="True"
                                    Text="{Loc 'wh40k-class-ui-purchase-node'}"/>
                            <PanelContainer Name="ConfirmationPanel" Visible="False" HorizontalExpand="True">
                                <RichTextLabel Name="ConfirmationText" HorizontalExpand="True" Margin="7"/>
                            </PanelContainer>
                            <BoxContainer Name="ConfirmationActions" Visible="False" Orientation="Horizontal"
                                          HorizontalExpand="True" SeparationOverride="7">
                                <Button Name="ConfirmPurchaseButton" HorizontalExpand="True"
                                        Text="{Loc 'wh40k-class-ui-confirm'}"/>
                                <Button Name="CancelPurchaseButton" HorizontalExpand="True"
                                        Text="{Loc 'wh40k-class-ui-cancel'}"/>
                            </BoxContainer>
                            <Control SetHeight="6"/>
                            <Label Text="{Loc 'wh40k-class-ui-bonus-list'}" FontColorOverride="#D7B45C"/>
                            <BoxContainer Name="BonusList" Orientation="Vertical" HorizontalExpand="True"
                                          SeparationOverride="4"/>
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <PanelContainer Name="LevelPanel" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="10 7" SeparationOverride="4">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="ClassLevelLabel" HorizontalExpand="True" FontColorOverride="#D7D2C3"/>
                        <Label Name="ExperienceLabel" HorizontalAlignment="Right" FontColorOverride="#D7B45C"/>
                    </BoxContainer>
                    <ProgressBar Name="ClassLevelBar" HorizontalExpand="True" SetHeight="12"
                                 MinValue="0" MaxValue="1"/>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Name="ExperienceToNextLabel" HorizontalExpand="True" FontColorOverride="#8F8C82"/>
                        <Label Name="NextPointLabel" HorizontalAlignment="Right" FontColorOverride="#8F8C82"/>
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </PanelContainer>
</DefaultWindow>
