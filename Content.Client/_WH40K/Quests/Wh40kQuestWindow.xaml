<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'wh40k-quest-ui-title'}"
               MinSize="620 500"
               SetSize="740 660">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                  Margin="8" SeparationOverride="6">

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="30"
                      SeparationOverride="8">
            <Label Name="ResultLabel" HorizontalExpand="True" VerticalAlignment="Center" />
            <Button Name="RefreshButton" Text="{Loc 'wh40k-quest-ui-refresh'}"
                    MinWidth="100" MinHeight="28" />
        </BoxContainer>

        <TabContainer Name="QuestTabs" HorizontalExpand="True" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True"
                             VerticalExpand="True">
                <BoxContainer Name="OffersRows" Orientation="Vertical"
                              HorizontalExpand="True" SeparationOverride="6"
                              Margin="4 6" />
            </ScrollContainer>
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True"
                             VerticalExpand="True">
                <BoxContainer Name="ActiveRows" Orientation="Vertical"
                              HorizontalExpand="True" SeparationOverride="6"
                              Margin="4 6" />
            </ScrollContainer>
            <ScrollContainer HScrollEnabled="False" HorizontalExpand="True"
                             VerticalExpand="True">
                <BoxContainer Name="HistoryRows" Orientation="Vertical"
                              HorizontalExpand="True" SeparationOverride="6"
                              Margin="4 6" />
            </ScrollContainer>
        </TabContainer>
    </BoxContainer>
</DefaultWindow>
