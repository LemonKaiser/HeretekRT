<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:preview="clr-namespace:Content.Client._WH40K.ShipPreview"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'wh40k-ship-preview-title'}"
                      MinSize="440 360"
                      SetSize="740 580">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6">
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#79603D" BackgroundColor="#100D0A"/>
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="8 6 8 6" SeparationOverride="2">
                <Label Name="VesselLabel" StyleClasses="LabelHeading" FontColorOverride="#E1C17E" />
                <Label Name="InfoLabel" StyleClasses="LabelSubText" FontColorOverride="#E9E1D0" />
                <Label Name="LiftLabel" StyleClasses="LabelSubText" FontColorOverride="#AD9F86" />
            </BoxContainer>
        </PanelContainer>
        <PanelContainer HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BorderThickness="2" BorderColor="#56452D" BackgroundColor="#090806"/>
            </PanelContainer.PanelOverride>
            <preview:Wh40kShipPreviewControl Name="Preview"
                                             HorizontalExpand="True"
                                             VerticalExpand="True"
                                             MinSize="200 200" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="ResetViewButton"
                    Text="{Loc 'wh40k-ship-preview-reset-view'}"
                    StyleClasses="ButtonSquare" />
            <Label Text="{Loc 'wh40k-ship-preview-hint'}"
                   StyleClasses="LabelSubText"
                   FontColorOverride="#AD9F86"
                   HorizontalExpand="True"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
