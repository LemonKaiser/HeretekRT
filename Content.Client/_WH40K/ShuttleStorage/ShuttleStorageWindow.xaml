<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:local="clr-namespace:Content.Client._WH40K.ShuttleStorage"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      SetSize="860 780" MinSize="680 500" Resizable="True">
    <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="12 8 12 10">
        <BoxContainer Orientation="Horizontal" SeparationOverride="12">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="StationLabel" StyleClasses="LabelSubText" ClipText="True" />
                <Label Text="{Loc 'wh40k-shuttle-storage-bay-title'}" StyleClasses="LabelHeading" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalAlignment="Right">
                <Label Text="{Loc 'wh40k-shuttle-storage-personal-slot'}" StyleClasses="LabelSubText" />
                <Label Name="OccupancyLabel" StyleClasses="LabelKeyText" FontColorOverride="#d5b676" />
            </BoxContainer>
        </BoxContainer>
        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" MinHeight="90">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" SeparationOverride="7">
                <Control SetHeight="340" HorizontalExpand="True">
                    <local:ShuttleStorageBayControl Name="BayPreview" />
                    <BoxContainer Orientation="Vertical" Margin="16 10 16 8" SeparationOverride="3" MouseFilter="Ignore">
                        <BoxContainer Orientation="Horizontal" SeparationOverride="12">
                            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                <Label Text="{Loc 'wh40k-shuttle-storage-projection'}" StyleClasses="LabelSubText" FontColorOverride="#a4aa9d" />
                                <Label Text="{Loc 'wh40k-shuttle-storage-bay-id'}" StyleClasses="LabelHeading" FontColorOverride="#d5b676" />
                            </BoxContainer>
                            <Label Name="BayStateLabel" FontColorOverride="#d5b676" />
                        </BoxContainer>
                        <Control VerticalExpand="True" MouseFilter="Ignore">
                            <Label Name="ProjectionPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" FontColorOverride="#a4aa9d" />
                        </Control>
                        <BoxContainer Orientation="Horizontal">
                            <Label Name="ProjectionDimensions" HorizontalExpand="True" StyleClasses="LabelSubText" FontColorOverride="#a4aa9d" />
                            <Button Name="ViewSwitchButton" Text="{Loc 'wh40k-shuttle-storage-hangar-view'}" StyleClasses="ButtonOpenBoth" />
                        </BoxContainer>
                    </BoxContainer>
                </Control>
                <ScrollContainer HScrollEnabled="False" SetHeight="170">
                    <BoxContainer Orientation="Vertical" SeparationOverride="7">
                        <Label Name="ManifestCaption" StyleClasses="LabelSubText" />
                        <Label Name="ManifestName" StyleClasses="LabelHeading" ClipText="True" />
                        <ScrollContainer Name="ShipPicker" HScrollEnabled="False" MinHeight="70" MaxHeight="80" Visible="False">
                            <BoxContainer Name="ShipsList" Orientation="Vertical" SeparationOverride="3" />
                        </ScrollContainer>
                        <RichTextLabel Name="SelectedLabel" />
                        <RichTextLabel Name="StoredDetailsLabel" />
                        <RichTextLabel Name="OperationResultLabel" Visible="False" />
                    </BoxContainer>
                </ScrollContainer>
                <RichTextLabel Name="LimitsLabel" />
            </BoxContainer>
        </ScrollContainer>
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#292c27" BorderColor="#9d824e" BorderThickness="0 3 0 0" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" Margin="0 10 0 2" SeparationOverride="10">
                <Button Name="StoreButton" Text="{Loc 'wh40k-shuttle-storage-store'}" HorizontalExpand="True" MinHeight="38" Disabled="True" />
                <Button Name="RetrieveButton" Text="{Loc 'wh40k-shuttle-storage-retrieve'}" HorizontalExpand="True" MinHeight="38" Disabled="True" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
