wh40k-boss-default-name = Unknown threat
wh40k-boss-hive-ship-name = Hive Ship
wh40k-boss-hive-ship-spore-mine-name = Spore mine
wh40k-boss-health = { $current } / { $max }
wh40k-boss-distance = { $distance } m

ent-BaseWh40kSpaceBoss = space boss
    .desc = An immense threat from the depths of space.
ent-MobWh40kHiveShipBoss = hive ship
    .desc = A colossal void organism whose armoured head and hooked mandibles tear at passing ships.
ent-SpawnWh40kHiveShipBoss = hive ship boss spawner
    .desc = Spawns the Hive Ship space boss.

ent-CrateWh40kHiveShipSpoils = hive ship spoils
    .desc = A salvaged plasma gun and meltagun, 30,000 credits, plasteel, gold, and a mysterious xenoartifact from the creature's gut.

ent-Wh40kHiveShipEncounter = hive ship encounter
    .desc = A rare hive ship appearance in the unprotected space of the Koronus sector.

ent-MobWh40kHiveShipBoarder = hive ship hormagaunt
    .desc = A vicious Tyranid spawned into the hull breach left by a hive ship's bite. It hunts the crew and pries open doors to reach its prey.
ent-Wh40kHiveShipSporeMine = hive ship spore mine
    .desc = A drifting biological mine that detonates against unprotected ships.
