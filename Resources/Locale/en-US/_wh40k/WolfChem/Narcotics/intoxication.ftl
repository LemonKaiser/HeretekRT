guide-entry-wh40k-narcotics = Narcotics and Neuroware

reagent-effect-guidebook-wh40k-dose =
    { $chance ->
        [1] Gets
        *[other] get
    } the user high; purer product hits harder and builds dependence faster
reagent-effect-guidebook-wh40k-sedation =
    { $chance ->
        [1] Sedates
        *[other] sedate
    } the user, and past the overdose slows their breathing; tolerance and a weaker grade blunt it
reagent-effect-guidebook-wh40k-clear-intoxication =
    { $chance ->
        [1] Reverses
        *[other] reverse
    } the effects of { $family }
reagent-effect-guidebook-wh40k-strain-heart =
    { $chance ->
        [1] Strains
        *[other] strain
    } the user's heart at high doses
reagent-effect-guidebook-wh40k-stamina-change =
    { $chance ->
        [1] Adjusts
        *[other] adjust
    } stamina by { $amount }

wh40k-drug-family-stimulant = stimulants
wh40k-drug-family-opioid = opioids
wh40k-drug-family-psychedelic = psychedelics
wh40k-drug-family-empathogen = empathogens
wh40k-drug-family-cannabinoid = cannabinoids
wh40k-drug-family-combat = combat drugs
wh40k-drug-family-nicotine = nicotine

wh40k-drug-phase-light = It's starting to kick in.
wh40k-drug-phase-heavy = It hits hard. You're well under now.
wh40k-drug-phase-overdose = Too much. Something is badly wrong with you.
wh40k-drug-phase-easing = The worst of it eases off.
wh40k-drug-phase-fading = You're coming down.

wh40k-drug-hallucination-whisper-1 = A hushed voice calls your name from just behind your shoulder.
wh40k-drug-hallucination-whisper-2 = Faint static murmurs through the bulkheads, almost forming words.
wh40k-drug-hallucination-whisper-3 = Someone whispers a warning right beside your ear, yet nobody is there.

wh40k-drug-hallucination-glimpse-1 = Something tall darts past the corner of your eye.
wh40k-drug-hallucination-glimpse-2 = The shadows stretch and fold over themselves when you aren't looking directly.
wh40k-drug-hallucination-glimpse-3 = For a heartbeat, the deck plating ripples like dark water.

wh40k-drug-hallucination-echo-1 = Heavy footsteps echo down an empty corridor behind you.
wh40k-drug-hallucination-echo-2 = A distant metallic clang repeats twice, each time closer.
wh40k-drug-hallucination-echo-3 = Your own heartbeat rings out like a gong inside the hull.

wh40k-drug-hallucination-phantom-1 = A pale figure watches you from the doorway, then dissolves into static.
wh40k-drug-hallucination-phantom-2 = Dozens of glowing eyes blink open along the bulkhead and vanish.
wh40k-drug-hallucination-phantom-3 = A cold hand brushes your neck, leaving only empty air behind you.

wh40k-nod-wake-1 = You jerk awake.
wh40k-nod-wake-2 = Your head snaps back up. How long were you out?
wh40k-nod-wake-3 = You blink hard. The world swims back.
wh40k-nod-emote-1 = nods off for a moment.
wh40k-nod-emote-2 = sways, eyes drooping shut.
wh40k-nod-emote-3 = drifts off mid-thought, then catches themselves.
wh40k-nod-host-wake-1 = Standby interrupted. The feed comes back.
wh40k-nod-host-wake-2 = Your optics relight. Several seconds are missing from the log.
wh40k-nod-host-wake-3 = The frame buffer refills. You were somewhere else.
wh40k-nod-host-emote-1 = stalls for a moment, optics dimming.
wh40k-nod-host-emote-2 = goes still as its fans spin down.
wh40k-nod-host-emote-3 = freezes mid-motion, then jerks back into it.
