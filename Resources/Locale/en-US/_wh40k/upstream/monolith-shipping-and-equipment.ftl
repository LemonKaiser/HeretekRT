ent-ComputerCargoOrdersUnderground = underground cargo request console
    .desc = Orders supplies and approves requests. It can order Underground supply crates to smuggle for telecrystals. It blocks access by the TSFMC and PDV.
ent-ComputerTabletopCargoOrdersUnderground = { ent-ComputerCargoOrdersUnderground }
    .desc = { ent-ComputerCargoOrdersUnderground.desc }
ent-CrateTradeBaseSecurePDV = Phaethon Dynasty supply crate
    .desc = Contains supplies for the Phaethon Dynasty Vanguard. Sell it at a cargo depot to receive payment. A tamper lock destroys the contents if the crate is broken.
ent-CrateTradeBaseSecureUnderground = Underground Black Market supply crate
    .desc = Contains deactivated telecrystals. Selling the crate at its destination funds the Underground Black Market and pays the courier. A tamper lock destroys the contents if the crate is broken.
ent-CrateTradeContrabandSecureUnderground = { ent-CrateTradeBaseSecureUnderground }
    .desc = { ent-CrateTradeBaseSecureUnderground.desc }
