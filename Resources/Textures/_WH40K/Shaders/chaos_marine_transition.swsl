light_mode unshaded;

uniform sampler2D SCREEN_TEXTURE;
uniform highp vec2 CenterPixels;
uniform highp float PhaseTime;
uniform highp vec2 BurstCenterPixels;
uniform highp float BurstRadiusPixels;
uniform highp float BurstProgress;
uniform highp float BurstAge;
uniform highp float GatherScale;

highp float hash21(highp vec2 p)
{
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

highp float noise21(highp vec2 p)
{
    highp vec2 cell = floor(p);
    highp vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash21(cell), hash21(cell + vec2(1.0, 0.0)), f.x),
        mix(hash21(cell + vec2(0.0, 1.0)), hash21(cell + vec2(1.0)), f.x), f.y);
}

void fragment()
{
    // Keep the original gathering field; the release uses the server's six-tile sweep.
    highp vec2 p = UV2 * 2.0 - vec2(1.0);
    highp vec2 gathering = p * GatherScale;
    highp float r = length(gathering);
    highp float theta = atan(gathering.y, gathering.x);
    highp float t = max(PhaseTime, 0.0);
    highp float edge = 1.0 - smoothstep(0.93, 0.999, length(p));
    highp float build = smoothstep(0.1, 3.9, t);
    highp float gather = smoothstep(0.05, 0.55, t) * (1.0 - smoothstep(4.05, 4.35, t));
    highp float curl = noise21(gathering * 5.0 + vec2(t * 0.21, -t * 0.3));
    highp float strands = pow(max(0.0, sin(theta * 13.0 + r * 8.0 - t * 0.9 + curl * 4.0)), 14.0);
    highp float inward = exp(-pow((fract(r * 3.6 + t * 0.82 + curl * 0.35) - 0.5) * 8.0, 2.0));
    highp float spiral = pow(max(0.0, sin(theta * 3.0 - r * 9.0 + t * 0.7 + curl * 0.8)), 10.0);
    highp float ribbon = spiral * exp(-pow((fract(r * 2.2 + t * 0.55) - 0.5) * 3.0, 2.0));
    highp float tendrils = (strands * inward * 1.5 + ribbon * 0.75) * gather * smoothstep(0.07, 0.2, r)
        * (1.0 - smoothstep(0.6, 0.95, r)) * (0.25 + build * 0.75);
    highp float core = exp(-r * r * 35.0) * build * gather;

    // Screen coordinates keep the impact front circular and aligned to its gameplay origin.
    highp vec2 screenDelta = FRAGCOORD.xy - BurstCenterPixels;
    highp vec2 wave = screenDelta / max(BurstRadiusPixels, 1.0);
    highp float waveRadius = length(wave);
    highp vec2 radial = wave / max(waveRadius, 0.001);
    highp float travel = clamp(BurstProgress, 0.0, 1.0);
    highp float age = max(BurstAge, 0.0);
    highp float turbulence = noise21(wave * 17.0 - radial * age * 9.0);
    highp float detail = noise21(wave * 39.0 - radial * age * 18.0 + vec2(age * 3.0));
    highp float flow = turbulence * 0.65 + detail * 0.35;
    highp float distanceToFront = waveRadius - travel;
    highp float width = 0.018 + travel * 0.01;
    highp float signedFront = distanceToFront / width;
    highp float release = step(0.0, BurstAge) * (1.0 - smoothstep(0.13, 0.21, BurstAge));
    highp float breakup = mix(1.0, smoothstep(0.22, 0.75, flow), smoothstep(0.11, 0.19, BurstAge));
    highp float distortion = exp(-signedFront * signedFront * 0.4) * release;
    highp float ridge = exp(-signedFront * signedFront * 1.8) * release * breakup * (0.45 + flow * 0.55);
    highp float tongueFront = distanceToFront + 0.05 + (flow - 0.5) * 0.13;
    highp float flames = exp(-pow(tongueFront / (0.04 + turbulence * 0.045), 2.0))
        * smoothstep(0.16, 0.72, flow) * release * breakup;
    // Each angular sector owns one small moving ember, rather than a stationary ring of square noise.
    highp float sector = floor((atan(wave.y, wave.x) + 3.14159265) * (24.0 / 6.2831853));
    highp float seed = hash21(vec2(sector, 17.0));
    highp float emberAngle = (sector + 0.2 + seed * 0.6) * (6.2831853 / 24.0) - 3.14159265;
    highp vec2 emberDirection = vec2(cos(emberAngle), sin(emberAngle));
    highp float emittedAt = 0.04 + hash21(vec2(sector, 31.0)) * 0.1;
    highp float emberAge = max(0.0, age - emittedAt);
    highp float emberRadius = emittedAt / 0.16 * 0.82 + emberAge * (1.5 + seed * 0.5);
    highp vec2 emberDelta = wave - emberDirection * emberRadius;
    highp float along = dot(emberDelta, emberDirection) / (0.009 + seed * 0.009);
    highp float across = dot(emberDelta, vec2(-emberDirection.y, emberDirection.x)) / 0.0035;
    highp float embers = exp(-along * along - across * across) * step(0.5, seed)
        * step(emittedAt, BurstAge) * exp(-emberAge * 14.0) * (1.0 - smoothstep(0.16, 0.25, emberAge));
    highp float flash = exp(-pow(BurstAge / 0.035, 2.0)) * exp(-waveRadius * waveRadius * 22.0);

    highp vec2 direction = screenDelta / max(length(screenDelta), 0.001);
    highp vec2 gatherDelta = FRAGCOORD.xy - CenterPixels;
    highp vec2 gatherDirection = gatherDelta / max(length(gatherDelta), 0.001);
    highp vec2 screenUv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp vec2 displacement = (direction * signedFront * distortion * 7.0
        - gatherDirection * tendrils * build * 1.2) * SCREEN_PIXEL_SIZE;
    highp vec3 scene = zTextureSpec(SCREEN_TEXTURE,
        clamp(screenUv + displacement, vec2(0.001), vec2(0.999))).rgb;
    highp vec3 crimson = vec3(0.85, 0.018, 0.035);
    highp vec3 gold = vec3(1.0, 0.72, 0.3);
    highp vec3 fire = mix(vec3(1.0, 0.055, 0.008), vec3(1.0, 0.4, 0.04), flow);
    highp vec3 light = crimson * (tendrils * 0.5 + core * 0.12)
        + fire * flames * 0.9 + gold * (ridge * 0.72 + embers * 0.8 + flash * 0.55);
    highp float opacity = clamp(tendrils * 0.33 + core * 0.12 + ridge * 0.5 + flames * 0.55
        + distortion * 0.25 + embers * 0.55 + flash * 0.36, 0.0, 0.85) * edge;
    COLOR = vec4(scene + light, opacity);
}
