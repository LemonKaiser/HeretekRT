light_mode unshaded;
blend_mode normal;
uniform highp vec4 StarColor;

highp float hash31(highp vec3 point) {
    point = fract(point * 0.1031);
    point += dot(point, point.yzx + 33.33);
    return fract((point.x + point.y) * point.z);
}
highp float valueNoise(highp vec3 point) {
    highp vec3 cell = floor(point);
    highp vec3 local = fract(point);
    highp vec3 blend = local * local * (3.0 - 2.0 * local);
    highp float lower = mix(
        mix(hash31(cell), hash31(cell + vec3(1.0, 0.0, 0.0)), blend.x),
        mix(hash31(cell + vec3(0.0, 1.0, 0.0)), hash31(cell + vec3(1.0, 1.0, 0.0)), blend.x), blend.y);
    highp float upper = mix(
        mix(hash31(cell + vec3(0.0, 0.0, 1.0)), hash31(cell + vec3(1.0, 0.0, 1.0)), blend.x),
        mix(hash31(cell + vec3(0.0, 1.0, 1.0)), hash31(cell + vec3(1.0, 1.0, 1.0)), blend.x), blend.y);
    return mix(lower, upper, blend.z);
}
highp float fbm(highp vec3 point) {
    highp float sum = 0.0;
    highp float amplitude = 0.55;
    for (highp int index = 0; index < 4; index++) {
        sum += valueNoise(point) * amplitude;
        point = point.yzx * 2.06 + vec3(11.1, 3.7, 8.3);
        amplitude *= 0.46;
    }
    return sum;
}
highp float granule(highp vec3 point) {
    highp vec3 cell = floor(point);
    highp vec3 local = fract(point);
    highp float nearest = 4.0;
    for (highp int z = -1; z <= 1; z++) {
        for (highp int y = -1; y <= 1; y++) {
            for (highp int x = -1; x <= 1; x++) {
                highp vec3 offset = vec3(float(x), float(y), float(z));
                highp vec3 centre = vec3(hash31(cell + offset), hash31(cell + offset + 17.3), hash31(cell + offset + 39.1));
                highp vec3 delta = offset + centre - local;
                nearest = min(nearest, dot(delta, delta));
            }
        }
    }
    return sqrt(nearest);
}
highp float diskAlpha(highp float radius) {
    highp float aa = 0.0015;
#ifdef FRAGMENT_SHADER
#ifdef HAS_DFDX
    aa = max(fwidth(radius), 0.0015);
#endif
#endif
    return 1.0 - smoothstep(1.0 - aa, 1.0 + aa, radius);
}

void fragment() {
    highp vec2 position = (UV - vec2(0.5)) * 2.08;
    highp float radius = length(position);
    if (radius > 1.01) discard;
    highp float depth = sqrt(max(1.0 - dot(position, position), 0.0));
    highp float time = TIME;
    highp float rotation = time * 0.011;
    highp vec3 sphere = vec3(position.x * cos(rotation) + depth * sin(rotation), position.y,
                             depth * cos(rotation) - position.x * sin(rotation));
    highp vec3 drift = vec3(time * 0.022, -time * 0.013, time * 0.006);
    highp vec3 tint = clamp(StarColor.rgb, vec3(0.0), vec3(1.0));
    highp float cells = 1.0 - smoothstep(0.08, 0.84, granule(sphere * 49.0 + drift));
    highp float magnetic = fbm(sphere * 8.0 + drift * 0.22);
    highp float spots = 1.0 - smoothstep(0.25, 0.31, magnetic);
    highp float heat = (0.47 + cells * 0.48) * (1.0 - spots * 0.82);
    highp vec3 colour = tint * heat * (0.72 + 0.28 * pow(depth, 0.5));
    colour += tint * smoothstep(0.30, 0.35, magnetic) * (1.0 - smoothstep(0.35, 0.39, magnetic)) * 0.15;
    COLOR = vec4(colour, diskAlpha(radius));
}
