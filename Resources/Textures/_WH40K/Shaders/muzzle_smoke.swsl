preset raw;

light_mode unshaded;

varying highp vec4 Tint;

void vertex()
{
    VERTEX = apply_mvp(aPos);
    UV = tCoord;
    UV2 = tCoord2;
    Tint = zFromSrgb(modulate);
}

highp float hash(highp vec2 cell)
{
    highp vec3 p = fract(vec3(cell.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

highp float noise(highp vec2 point)
{
    highp vec2 cell = floor(point);
    highp vec2 f = fract(point);
    f = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(cell), hash(cell + vec2(1.0, 0.0)), f.x),
               mix(hash(cell + vec2(0.0, 1.0)), hash(cell + vec2(1.0, 1.0)), f.x), f.y);
}

void fragment()
{
    highp float age = UV.x;
    highp float seed = UV.y;
    highp vec2 point = (floor(UV2 * 22.0) + vec2(0.5)) / 22.0 - vec2(0.5);
    highp float grain = noise(point * vec2(15.0, 9.0) + vec2(seed * 29.0, -age * 0.6));
    highp float width = mix(0.11, 0.24, age) * mix(0.58, 1.38, smoothstep(-0.35, 0.24, point.y));
    point.x -= point.y * (seed - 0.5) * 0.44;
    highp vec2 flow = vec2(point.x / width, (point.y - 0.04) / 0.41);
    highp float body = 1.0 - smoothstep(0.22, 1.05, dot(flow, flow) + (0.52 - grain) * 0.78);
    highp float erosion = smoothstep(0.23 + age * 0.37, 0.62 + age * 0.25, grain);
    highp float density = body * mix(0.72, 1.0, grain) * mix(0.83, erosion, smoothstep(0.04, 0.69, age));
    highp float alpha = density * Tint.a;
    if (alpha < 0.012)
        discard;

    COLOR = vec4(Tint.rgb * mix(0.81, 1.0, grain), alpha);
}
