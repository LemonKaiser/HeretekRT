preset raw;

varying highp vec2 Pos;
varying highp vec4 VtxModulate;

uniform highp float Speed;
uniform highp float Dis;
uniform highp float Offset;

void fragment()
{
    COLOR = zTexture(UV) * VtxModulate;
}

void vertex()
{
    highp vec2 pos = aPos;
    // Post-shader quads have y = 0 at the bottom. Keep that edge fixed and preserve the wave phase.
    pos.x -= sin(TIME * Speed + Offset) * Dis * tCoord2.y;
    VERTEX = apply_mvp(pos);

    Pos = (VERTEX + 1.0) / 2.0;
    UV = mix(modifyUV.xy, modifyUV.zw, tCoord);
    UV2 = tCoord2;
    VtxModulate = zFromSrgb(modulate);
}
